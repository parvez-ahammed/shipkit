{
  "name": "my-video",
  "size": [1920, 1080],
  "fps": 30,
  "target": 20,
  "voice": { "name": "af_heart", "speed": 1.05, "pronounce": { "Acme": "Ack-me" } },
  "music": { "bpm": 112, "chords": ["C", "Am", "F", "G"], "intro": "tension", "dropAt": "scene:turn", "endAt": "scene:cta+0.3" },
  "scenes": [
    { "id": "hook", "lead": 0.1, "lines": [{ "id": "hook", "say": "Still copying data between tools by hand?" }] },
    { "id": "turn", "min": 2.8, "lead": 0.5, "lines": [{ "id": "turn", "say": "Acme does it for you." }] },
    { "id": "feature", "weight": 2, "lead": 0.2, "lines": [{ "id": "feature", "say": "It keeps every system in sync, automatically." }] },
    { "id": "cta", "hold": 1.2, "lead": 0.3, "lines": [{ "id": "cta", "say": "Try Acme today." }] }
  ],
  "sfx": [
    { "type": "ticks", "at": 0.1, "until": "sceneEnd:hook-0.3" },
    { "type": "riser", "at": "scene:turn", "len": 1.2 },
    { "type": "impact", "at": "scene:turn" },
    { "type": "whoosh", "at": "scene:feature-0.12" },
    { "type": "success", "at": "lineEnd:feature" }
  ]
}
